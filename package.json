name: Gerar APK - Cuidado Juntos

on:
  workflow_dispatch:

  push:
    branches:
      - main


jobs:

  build-apk:

    name: Construir APK Android

    runs-on: ubuntu-latest


    steps:

      # =====================================================
      # 1. BAIXAR O CÓDIGO
      # =====================================================

      - name: Baixar código
        uses: actions/checkout@v4


      # =====================================================
      # 2. CONFIGURAR NODE.JS
      # =====================================================

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22


      # =====================================================
      # 3. CONFIGURAR JAVA
      # =====================================================

      - name: Configurar Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"


      # =====================================================
      # 4. VERIFICAR AMBIENTE
      # =====================================================

      - name: Verificar ambiente
        run: |
          echo "===== NODE ====="
          node --version

          echo "===== NPM ====="
          npm --version

          echo "===== JAVA ====="
          java -version


      # =====================================================
      # 5. INSTALAR DEPENDÊNCIAS
      # =====================================================

      - name: Instalar dependências
        run: npm install


      # =====================================================
      # 6. PREPARAR A PASTA WWW
      # =====================================================

      - name: Preparar aplicativo web
        run: |
          echo "Preparando aplicativo..."

          rm -rf www

          mkdir -p www

          cp index.html www/
          cp style.css www/
          cp script.js www/
          cp native-notifications.js www/

          cp -r img www/

          echo ""
          echo "Arquivos preparados:"
          find www -maxdepth 2 -type f


      # =====================================================
      # 7. VERIFICAR LOGO
      # =====================================================

      - name: Verificar arquivos de imagem
        run: |
          echo "===== LOGO ====="

          if [ -f "img/logo.png" ]; then
            echo "Logo encontrada."
            file img/logo.png
          else
            echo "ERRO: img/logo.png não encontrada."
            exit 1
          fi

          echo ""
          echo "===== NOTIFICAÇÃO ====="

          if [ -f "img/notificacao.png" ]; then
            echo "Ícone de notificação encontrado."
            file img/notificacao.png
          else
            echo "ERRO: img/notificacao.png não encontrada."
            exit 1
          fi


      # =====================================================
      # 8. ADICIONAR ANDROID
      # =====================================================

      - name: Adicionar projeto Android
        run: |
          if [ ! -d "android" ]; then
            echo "Criando projeto Android..."
            npx cap add android
          else
            echo "Projeto Android já existe."
          fi


      # =====================================================
      # 9. PREPARAR ASSETS
      # =====================================================

      - name: Preparar assets
        run: |
          mkdir -p assets

          cp img/logo.png assets/logo.png

          echo "Asset da logo preparado."


      # =====================================================
      # 10. GERAR ÍCONE E SPLASH
      # =====================================================

      - name: Gerar ícones e Splash Screen
        run: |
          npx capacitor-assets generate \
            --android \
            --iconBackgroundColor "#2563eb" \
            --splashBackgroundColor "#2563eb"


      # =====================================================
      # 11. SINCRONIZAR CAPACITOR
      # =====================================================

      - name: Sincronizar Capacitor
        run: |
          npx cap sync android


      # =====================================================
      # 12. PREPARAR ÍCONE DE NOTIFICAÇÃO
      # =====================================================

      - name: Preparar ícone de notificação
        run: |

          mkdir -p \
            android/app/src/main/res/drawable

          cp img/notificacao.png \
            android/app/src/main/res/drawable/notificacao.png

          echo "Ícone de notificação instalado."


      # =====================================================
      # 13. CONFIGURAR PERMISSÃO DE NOTIFICAÇÕES
      # =====================================================

      - name: Configurar notificações Android
        run: |

          python3 - <<'PY'

          from pathlib import Path

          manifest = Path(
              "android/app/src/main/AndroidManifest.xml"
          )

          texto = manifest.read_text()

          permissao = (
              '    <uses-permission '
              'android:name="android.permission.POST_NOTIFICATIONS" />'
          )

          if "android.permission.POST_NOTIFICATIONS" not in texto:

              marcador = "</manifest>"

              if marcador not in texto:
                  raise SystemExit(
                      "AndroidManifest.xml não possui </manifest>"
                  )

              texto = texto.replace(
                  marcador,
                  permissao + "\n" + marcador
              )

              manifest.write_text(texto)

          print(
              "Permissão de notificações configurada."
          )

          PY


      # =====================================================
      # 14. VERIFICAR MANIFEST
      # =====================================================

      - name: Verificar AndroidManifest
        run: |

          echo "========================================"
          echo "ANDROID MANIFEST"
          echo "========================================"

          cat android/app/src/main/AndroidManifest.xml

          echo "========================================"
          echo "CAPACITOR CONFIG"
          echo "========================================"

          cat capacitor.config.json


      # =====================================================
      # 15. PERMITIR EXECUÇÃO DO GRADLE
      # =====================================================

      - name: Permitir execução do Gradle
        run: |

          chmod +x android/gradlew


      # =====================================================
      # 16. LIMPAR BUILD ANTERIOR
      # =====================================================

      - name: Limpar projeto Android
        working-directory: android
        run: |

          ./gradlew clean


      # =====================================================
      # 17. GERAR APK
      # =====================================================

      - name: Gerar APK Debug
        working-directory: android
        run: |

          ./gradlew assembleDebug


      # =====================================================
      # 18. VERIFICAR APK
      # =====================================================

      - name: Verificar APK gerado
        run: |

          echo "========================================"
          echo "APK GERADO"
          echo "========================================"

          ls -lh \
            android/app/build/outputs/apk/debug/app-debug.apk


      # =====================================================
      # 19. PUBLICAR APK
      # =====================================================

      - name: Publicar APK
        uses: actions/upload-artifact@v4

        with:
          name: cuidado-juntos-apk

          path: android/app/build/outputs/apk/debug/app-debug.apk

          if-no-files-found: error
